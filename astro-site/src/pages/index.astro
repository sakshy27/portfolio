---
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import WorkCard from '../components/WorkCard.astro';
import ExperimentRow from '../components/ExperimentRow.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Topbar />

  <main class="wrap">
    <Hero />

    <!-- Selected work -->
    <section class="sec" id="work">
      <SectionHead title="Selected work" count="04 projects" separator />
      <div class="work-list">
        <WorkCard
          href="/work/agents"
          kicker="New Feature · Work Project · Juspay"
          title="Building the agent creation experience"
          desc="A deep dive into the agent creation space, shaping an experience for 1600+ employees at Juspay to build agents for their own workflows and work alongside them."
          thumbImage="/images/agents.png"
        />
        <WorkCard
          href="/work/tickets"
          kicker="New Feature · Work Project · Xyne Spaces by Juspay"
          title="Imagining ticket experience for human and agent shared workspace"
          desc="An end-to-end design of how humans and AI agents collaborate to resolve tickets in Xyne Spaces, an internal AI-powered workspace tool."
          thumbImage="/images/xyne-tickets.png"
        />
        <WorkCard
          href="/work/dukaan"
          kicker="New Feature · Personal Project · Dukaan"
          title="Introducing Subscriptions to boost sales and retention for sellers on Dukaan"
          desc="Conducted in-depth research on stakeholders (Dukaan, sellers, customers) to deliver solutions aligned with user needs and business goals."
          thumbImage="/images/dukaan-cover.png"
        />
        <WorkCard
          href="/work/gbot-x"
          kicker="0-1 Product · Work Project · Gemach"
          title="Simplifying Crypto Trading: A decentralized platform for traders"
          desc="Conducted in-depth research, user interviews, and usability testing to design a seamless and intuitive experience for traders."
          thumbImage="/images/gbot-x-cover.png"
        />
      </div>
    </section>

    <!-- Claude experiments -->
    <section class="sec" id="ai-builds">
      <SectionHead title="Built with Claude" count="02 experiments" separator />
      <div class="exp-list" id="exp-list">
        <ExperimentRow
          href="https://splitfree-tbc.vercel.app/"
          title="Splitfree"
          desc="A better and free alternative to Splitwise."
          previewSrc="/images/splitfree2.mov"
          horizontalPreviewSrc="/images/splitfree-preview.mov"
          fullWidth
        />
        <ExperimentRow
          href="https://air-slice.vercel.app/"
          title="Air Slice"
          desc="Fruit Ninja reimagined with real-time hand tracking through your webcam."
          previewSrc="/images/airslice-preview.mov"
        />
      </div>
    </section>
  </main>

  <!-- Variant switcher panel -->
  <div class="variant-panel">
    <div class="vp-label">Layout</div>
    <div class="vp-buttons">
      <button class="vp-btn active" data-variant="vertical">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <rect x="2" y="2" width="12" height="4" rx="1" fill="currentColor"/>
          <rect x="2" y="8" width="12" height="4" rx="1" fill="currentColor" opacity="0.35"/>
        </svg>
        Vertical
      </button>
      <button class="vp-btn" data-variant="horizontal">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <rect x="2" y="2" width="5" height="12" rx="1" fill="currentColor"/>
          <rect x="9" y="2" width="5" height="12" rx="1" fill="currentColor" opacity="0.35"/>
        </svg>
        Horizontal
      </button>
    </div>
  </div>

  <Footer />
</Base>

<script>
  const list = document.getElementById('exp-list');
  const btns = document.querySelectorAll<HTMLButtonElement>('.vp-btn');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const variant = btn.getAttribute('data-variant') ?? 'vertical';
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      if (list) list.setAttribute('data-variant', variant);
    });
  });
</script>

<style>
  .sec { padding: var(--space-48) 0; }
  .work-list { display: flex; flex-direction: column; gap: var(--space-72); }

  .exp-list { display: flex; flex-direction: column; gap: var(--space-72); }
  .exp-list[data-variant="horizontal"] {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-48);
  }

  /* Variant panel */
  .variant-panel {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px 14px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.10);
    z-index: 999;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .vp-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .vp-buttons {
    display: flex;
    gap: 6px;
  }
  .vp-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 7px;
    border: 1px solid var(--line);
    background: transparent;
    font-size: 13px;
    color: var(--ink-2);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .vp-btn:hover { background: var(--line-2); color: var(--ink); }
  .vp-btn.active {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }

  @media (max-width: 600px) {
    .sec { padding: var(--space-32) 0; }
    .work-list { gap: 40px; }
    .exp-list { gap: 40px; }
    .exp-list[data-variant="horizontal"] { grid-template-columns: 1fr; }
    .variant-panel { bottom: 16px; right: 16px; }
  }
</style>
