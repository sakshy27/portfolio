---
import CaseStudy from '../../layouts/CaseStudy.astro';

const sections = [
  { id: 'overview', label: 'Overview' },
  { id: 'audience', label: 'Target Audience' },
  { id: 'goal', label: 'Goal' },
  { id: 'impact', label: 'Impact' },
];
---

<CaseStudy
  title="Xyne Claw: Enabling Human–AI Collaboration"
  kicker="New Feature · Work Project · Juspay"
  description="Designing a platform where teams can create, discover, and collaborate with agents that automate repetitive work and simplify everyday workflows."
  role="Solo Designer"
  timeline="2026"
  platform="New Feature"
  platformLabel="Type"
  platformClass="agents-type-meta"
  context="Xyne Claw by Jupsay"
  contextLabel="Product"
  sections={sections}
  nextProject={{ href: "/work/dukaan", title: "Next" }}
>

  <div class="cs-cover agents-cover">
    <img src="/images/clawww.png" alt="Xyne Claw cover" />
  </div>

  {/* ═══ OVERVIEW ═══ */}
  <section class="cs-section agents-section" id="overview">
    <div class="sec-head">
      <h2>Overview</h2>
    </div>
    <div class="cs-body">
      <p>As a Product Designer at Juspay, I designed the core experience for <strong>Xyne Claw</strong>, the platform that enables teams to <strong>create, configure, and deploy agents</strong> within <strong>Xyne Spaces</strong>, our AI-native work OS platform.</p>

      <p>My work established the foundation for how <strong>agents are created, connected to enterprise knowledge and tools</strong>, and brought into <strong>everyday workflows at scale</strong>.</p>
    </div>
  </section>

  {/* ═══ TARGET AUDIENCE ═══ */}
  <section class="cs-section agents-section no-following-separator" id="audience">
    <div class="sec-head">
      <h2>Target Audience</h2>
    </div>
    <div class="cs-body">
      <p>Anyone across the organization&mdash;from non-technical to technical teams&mdash;enabling them to easily create and collaborate with <strong>agents</strong> in their day-to-day workflows.</p>
    </div>
  </section>

  {/* ═══ GOAL ═══ */}
  <section class="cs-section agents-section no-following-separator" id="goal">
    <div class="sec-head">
      <h2>Goal</h2>
    </div>
    <div class="cs-body">
      <p>Design an experience that enabled anyone, regardless of technical expertise, to use and create <strong>agents</strong> in their day-to-day workflow.</p>
    </div>
  </section>

  {/* ═══ IMPACT ═══ */}
  <section class="cs-section agents-section" id="impact">
    <div class="sec-head">
      <h2>Impact</h2>
    </div>
    <div class="cs-body">
      <ul class="impact-list">
        <li>Successfully beta launched to <strong>1,600+ employees</strong> across Juspay.</li>
        <li>Increased <strong>accessibility of AI</strong> by enabling users across technical and non-technical teams to create agents.</li>
        <li>Simplified <strong>repetitive workflows</strong> through reusable AI agents.</li>
        <li>Enabled <strong>knowledge sharing</strong> through publishable and reusable agents.</li>
      </ul>
    </div>
  </section>

  <div class="nda-banner">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="10" height="7" rx="1.5"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"/></svg>
    This project is under NDA. Happy to discuss in detail on call.
  </div>

</CaseStudy>

<style is:global>
  .agents-cover {
    aspect-ratio: unset;
    height: auto;
  }
  .agents-cover img {
    width: 100%;
    height: auto;
    object-fit: unset;
  }
  .nda-banner {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: var(--space-32);
    padding: var(--space-16) 20px;
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: var(--radius-md);
    font-size: var(--text-desc);
    color: var(--ink-2);
  }
  .nda-banner svg { flex-shrink: 0; color: rgb(59, 130, 246); }
  .nda-banner a {
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    transition: border-color var(--ease-default);
  }
  .nda-banner a:hover { border-color: var(--ink); }
  .impact-list {
    margin: 0;
    padding-left: 1.25em;
  }
  .impact-list li + li { margin-top: 10px; }
  .agents-section .sec-head {
    border-bottom-color: color-mix(in srgb, var(--ink) 15.6%, var(--bg));
  }
  .agents-type-meta { margin-left: -40px; }
  .no-following-separator + .cs-section { border-top: 0; }
  #audience,
  #goal,
  #impact { border-top: 0; }
  @media (max-width: 600px) { .agents-type-meta { margin-left: 0; } }
</style>
