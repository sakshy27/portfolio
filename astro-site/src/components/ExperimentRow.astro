---
interface Props {
  href: string;
  title: string;
  desc: string;
  previewSrc?: string;
  fullWidth?: boolean;
}

const { href, title, desc, previewSrc, fullWidth } = Astro.props;
---

<a href={href} class="exp" {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
  <div class={`e-frame${fullWidth ? ' full-width' : ''}`}>
    <div class="e-thumb">
      {previewSrc ? (
        <video src={previewSrc} autoplay loop muted playsinline class="e-video e-video--main" />
      ) : (
        <div class="e-placeholder"></div>
      )}
    </div>
  </div>
  <div class="e-body">
    <div class="e-meta">
      <div class="e-title">{title}</div>
      <svg class="e-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8h9M8.5 4l4 4-4 4"/></svg>
    </div>
    <div class="e-desc">{desc}</div>
  </div>
</a>

<style>
  .exp {
    display: block;
    transition: transform var(--ease-card);
  }
  .exp:hover .e-title { color: var(--accent); }
  .exp:hover .e-arrow { transform: translateX(4px); }
  .e-frame {
    height: 600px;
    overflow: hidden;
    background: var(--line-2);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-24);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
  }
  .e-thumb {
    height: 100%;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
  }
  .e-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .full-width .e-video { object-fit: contain; }
  .e-placeholder {
    width: 160px;
    height: 100%;
    background: var(--line);
    border-radius: 8px;
  }
  .e-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-16);
    margin-bottom: var(--space-4);
  }
  .e-title {
    font-size: var(--text-work-title);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--ink);
    transition: color var(--ease-default);
  }
  .e-desc {
    font-size: var(--text-desc);
    color: var(--ink-2);
    line-height: var(--leading-body);
  }
  .e-arrow {
    color: var(--muted);
    flex-shrink: 0;
    transition: color var(--ease-default), transform var(--ease-default);
  }

  @media (max-width: 600px) {
    .e-title { font-size: 19px; }
  }
</style>
